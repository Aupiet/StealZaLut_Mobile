# R8 Keep Rules for StealZaLut Mobile
# AGP combines all keep rule files in src/main/keepRules to pass to R8.
# Minification is enabled in release builds with resource shrinking.
# Chaquopy runtime AAR includes its own internal consumer rules for python-bridge.

# Domain models & serialized presets/settings
-keep class com.stealzalut.mobile.data.model.** { *; }

# Android application entry points declared in AndroidManifest.xml
-keep public class com.stealzalut.mobile.MainActivity
-keep public class com.stealzalut.mobile.StealZaLutApplication
