    <!-- Guide 3D LUT Creation Features -->
    <string name="guide_algorithms_title">3D Color Transfer Algorithms</string>
    <string name="guide_algorithms_desc">Mathematical optimal transport and statistical color matching models</string>
    <string name="guide_algorithms_detail">StealZaLUT embeds 4 advanced mathematical models: Monge-Kantorovitch Linear (MKL optimal transport in covariance space), Histogram Matching (HM per-channel cumulative mapping), Reinhard (perceptual Lab statistical moments), and Hybrid Cinematic (chained HM+MKL for cinematic grading without crushing).</string>
    <string name="guide_algorithms_p1_name">MKL (Covariance)</string>
    <string name="guide_algorithms_p1_desc">Optimal transport matching the 3D RGB color covariance ellipsoid.</string>
    <string name="guide_algorithms_p2_name">Hybrid Cinematic</string>
    <string name="guide_algorithms_p2_desc">Chained HM + MKL combining histogram dynamic range and optimal transport.</string>

    <string name="guide_protections_title">OKLab Color Protections &amp; Masks</string>
    <string name="guide_protections_desc">Gamut safeguards, skin preservation, and gradient continuity</string>
    <string name="guide_protections_detail">Safeguards subject authenticity during extreme grade transfers. Operates in perceptual OKLab space to isolate human skin tones, anchor neutral grays, and lock luminance contrast curves.</string>
    <string name="guide_protections_p1_name">Luma &amp; Neutral Lock</string>
    <string name="guide_protections_p1_desc">Prevents contrast shifts and keeps pure whites and blacks neutral without unwanted color casts.</string>
    <string name="guide_protections_p2_name">Skin Tone Lock &amp; 3D Smoothing</string>
    <string name="guide_protections_p2_desc">Preserves natural skin complexion and smooths 3D lattice gradients to eliminate banding.</string>

    <string name="guide_lattice_title">3D LUT Lattice Resolution</string>
    <string name="guide_lattice_desc">Volumetric color cube sampling density and interpolation</string>
    <string name="guide_lattice_detail">Determines the density of the 3-dimensional color sampling cube. Higher grid resolutions provide finer sub-color gradients and subtle transitions.</string>
    <string name="guide_lattice_p1_name">17³ &amp; 33³ Mobile Standards</string>
    <string name="guide_lattice_p1_desc">17x17x17 for ultra-fast mobile rendering, 33x33x33 for the optimal quality/memory ratio.</string>
    <string name="guide_lattice_p2_name">64³ Cinema Precision</string>
    <string name="guide_lattice_p2_desc">64x64x64 high-density cube meeting DaVinci Resolve and film mastering requirements.</string>

